# העתיקו לקובץ .env ומלאו ערכים. אין לשמור את .env ב-git.
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
# כתובת האתר הציבורית (משמשת לקישורי איפוס סיסמה ולבדיקת מקור)
PUBLIC_URL=https://coord.example.gov.il
# 1 כשהשרת יושב מאחורי Nginx / Load Balancer שמעביר X-Forwarded-For/Proto
TRUST_PROXY=1
# בפרודקשן HTTPS מחויב כברירת מחדל (0 מבטל – לא מומלץ)
FORCE_HTTPS=1
# מקורות נוספים שמורשים לקרוא ל-API (ריק = רק האתר עצמו)
ALLOWED_ORIGINS=
# אחסון. מומלץ ש-BACKUP_DIR יהיה דיסק ענן מעוגן / תיקייה מסונכרנת מחוץ לשרת
DATA_DIR=data
UPLOAD_DIR=data/uploads
BACKUP_DIR=data/backups
LOG_DIR=data/logs
BACKUP_INTERVAL_MINUTES=60
BACKUP_RETENTION_DAYS=30
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
RESET_TOKEN_MINUTES=30
# דוא"ל לאיפוס סיסמה (שרת SMTP של הארגון). בלי הגדרה – בקשות איפוס מגיעות כהתראה למנהל.
SMTP_HOST=
SMTP_PORT=587
# 1 = TLS מלא (פורט 465). אחרת נעשה STARTTLS; שליחה בלי הצפנה נחסמת.
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM="מערכת תיאום הנדסי <no-reply@example.gov.il>"
# "זכור אותי": ימים עד ניתוק, וימים בלי שימוש עד ניתוק
REMEMBER_DAYS=30
REMEMBER_IDLE_DAYS=7
# סנכרון לענן (חובה באחסון שהדיסק שלו נמחק, כמו Render בחינם). בלי זה – הכל נשמר רק בדיסק של השרת.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=handasa
# מנהל ראשון אוטומטי (נוצר רק כשאין אף משתמש)
ADMIN_USERNAME=
ADMIN_FULLNAME=
ADMIN_PASSWORD=

# מפת GovMap לסימון מיקום העבודה (טוקן לדומיין, מבקשים ב-gov.il). אפשר גם מהגדרות וקבצים
GOVMAP_TOKEN=
